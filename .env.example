# Defaults are editable in src/config/config.py. Environment variables win.
# Ollama model presets: qwen3.5:4b (local CPU/GPU), qwen3.8:27b (Qwen/Qwen3.8-27B, 24GB+ GPU recommended)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
LLM_MINI_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker host port. Keep OLLAMA_BASE_URL in sync when changing it.
OLLAMA_PORT=11434
# Future Colab SSH tunnel: OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_NUM_CTX=8192
OLLAMA_THINKING=false
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=300
SEARCH_PROVIDER=duckduckgo
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Optional providers (set LLM_MODEL and LLM_MINI_MODEL to the desired model)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_MINI_MODEL=gemini-2.5-flash-lite
# GEMINI_API_KEY=
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_REASONING_EFFORT=low
# OpenAI-compatible Hugging Face server (vLLM / SGLang) for Qwen/Qwen3.8-27B:
# LLM_PROVIDER=openai
# LLM_MODEL=Qwen/Qwen3.8-27B
# LLM_MINI_MODEL=Qwen/Qwen3.8-27B
# OPENAI_BASE_URL=http://127.0.0.1:8001/v1
# OPENAI_API_KEY=EMPTY
# LLM_PROVIDER=upstage
# UPSTAGE_API_KEY=
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=

# Local PostgreSQL (Docker Compose). Generate separate random passwords in .env.
POSTGRES_DB=div
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
APP_DB_USER=div_app
APP_DB_PASSWORD=
# Required for the dashboard persistence layer.
# URL-encode passwords with special characters in DATABASE_URL.
# DATABASE_URL=postgresql://div_app:<APP_DB_PASSWORD>@127.0.0.1:5432/div

# Required for signed OAuth state. Generate locally; never commit the real value.
AUTH_SECRET=
APP_BASE_URL=http://127.0.0.1:8000
# Initial administrator, synced on every server start (password: 4+ chars).
# Changing ADMIN_PASSWORD rotates the password and signs out existing sessions.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional Google login; register APP_BASE_URL/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
